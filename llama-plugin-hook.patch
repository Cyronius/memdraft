+// drafter loaded from a shared library, see speculative-plugin.h
+struct common_speculative_impl_plugin : public common_speculative_impl {
+    common_params_speculative_plugin params;
+
+    void * lib = nullptr;
+    const llama_spec_plugin * api = nullptr;
+    void * state = nullptr;
+
+    int32_t n_vocab = 0;
+
+    struct request {
+        llama_tokens tokens;
+        llama_tokens out;
+    };
+    std::vector<request> reqs; // per sequence
+    std::vector<llama_spec_plugin_draft> calls;
+    const llama_tokens no_prefix;
+
+    common_speculative_impl_plugin(const common_params_speculative & params, uint32_t n_seq)
+        : common_speculative_impl(COMMON_SPECULATIVE_TYPE_PLUGIN, n_seq, params.plugin.n_max)
+        , params(params.plugin) {
+        const auto & path = this->params.path;
+        if (path.empty()) {
+            throw std::runtime_error("--spec-type plugin needs --spec-plugin FNAME");
+        }
+
+#ifdef _WIN32
+        lib = (void *) LoadLibraryA(path.c_str());
+#else
+        lib = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+#endif
+        if (!lib) {
+            throw std::runtime_error("cannot load speculative plugin: " + path);
+        }
+
+        auto get = (llama_spec_plugin_get_fn) sym(LLAMA_SPEC_PLUGIN_ENTRY);
+        api = get ? get() : nullptr;
+        if (!api || api->api_version != LLAMA_SPEC_PLUGIN_API_VERSION ||
+            !api->init || !api->free || !api->begin || !api->draft || !api->accept) {
+            close();
+            throw std::runtime_error("not a speculative plugin of API version " + std::to_string(LLAMA_SPEC_PLUGIN_API_VERSION) + ": " + path);
+        }
+
+        uint64_t vocab_hash = 0;
+        if (this->params.ctx_tgt) {
+            const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(this->params.ctx_tgt));
+            n_vocab = llama_vocab_n_tokens(vocab);
+            vocab_hash = 0xcbf29ce484222325ULL;
+            for (llama_token id = 0; id < n_vocab; ++id) {
+                const char * text = llama_vocab_get_text(vocab, id);
+                for (size_t i = 0; i < strlen(text) + 1; ++i) { // the 0 byte separates tokens
+                    vocab_hash = (vocab_hash ^ (uint8_t) text[i]) * 0x100000001b3ULL;
+                }
+            }
+        }
+
+        std::vector<const char *> keys;
+        std::vector<const char *> values;
+        for (const auto & kv : this->params.args) {
+            keys.push_back(kv.first.c_str());
+            values.push_back(kv.second.c_str());
+        }
+
+        const llama_spec_plugin_init_params iparams = {
+            /* .n_seq      = */ n_seq,
+            /* .n_max      = */ this->params.n_max,
+            /* .n_prefix   = */ this->params.n_prefix,
+            /* .n_vocab    = */ n_vocab,
+            /* .vocab_hash = */ vocab_hash,
+            /* .ctx_tgt    = */ this->params.ctx_tgt,
+            /* .n_args     = */ keys.size(),
+            /* .keys       = */ keys.data(),
+            /* .values     = */ values.data(),
+        };
+
+        char err[512] = {0};
+        state = api->init(&iparams, err, sizeof(err) - 1);
+        if (!state) {
+            close();
+            throw std::runtime_error("speculative plugin " + path + " failed: " + err);
+        }
+
+        reqs.resize(n_seq);
+
+        SPC_INF("loaded speculative plugin %s, n_max = %d, n_prefix = %d\n", path.c_str(), this->params.n_max, this->params.n_prefix);
+    }
+
+    ~common_speculative_impl_plugin() override {
+        if (state) {
+            api->free(state);
+        }
+        close();
+    }
+
+    void * sym(const char * name) const {
+#ifdef _WIN32
+        return (void *) GetProcAddress((HMODULE) lib, name);
+#else
+        return dlsym(lib, name);
+#endif
+    }
+
+    void close() {
+        if (lib) {
+#ifdef _WIN32
+            FreeLibrary((HMODULE) lib);
+#else
+            dlclose(lib);
+#endif
+            lib = nullptr;
+        }
+    }
+
+    void begin(llama_seq_id seq_id, const llama_tokens & prompt) override {
+        api->begin(state, seq_id, prompt.data(), prompt.size());
+    }
+
+    std::vector<int32_t> b_tokens, b_pos, b_seq;
+    std::vector<int8_t>  b_output;
+
+    bool process(const common_batch & batch) override {
+        if (!api->process || batch.size() <= 0) {
+            return true;
+        }
+        const int32_t n = batch.size();
+        b_tokens.resize(n);
+        b_pos.resize(n);
+        b_seq.resize(n);
+        b_output.resize(n);
+        for (int32_t i = 0; i < n; ++i) {
+            const auto & t = batch.tokens[i];
+            b_tokens[i] = t.id;
+            b_pos[i]    = t.pos[0];
+            b_seq[i]    = t.seq_id;
+            b_output[i] = t.output ? 1 : 0;
+        }
+        const llama_spec_plugin_batch b = { n, b_tokens.data(), b_pos.data(), b_seq.data(), b_output.data() };
+        return api->process(state, &b) == 0;
+    }
+
+    bool get_state(llama_seq_id seq_id, std::vector<uint8_t> & data) const override {
+        if (!api->get_state) {
+            return false;
+        }
+        data.resize(api->get_state(state, seq_id, nullptr, 0));
+        return api->get_state(state, seq_id, data.data(), data.size()) == data.size();
+    }
+
+    void set_state(llama_seq_id seq_id, const std::vector<uint8_t> & data) override {
+        if (api->set_state) {
+            api->set_state(state, seq_id, data.data(), data.size());
+        }
+    }
+
+    // prefixes[seq_id]: tokens from the draft model that the plugin continues (--spec-plugin-prefix)
+    void draft_with(common_speculative_draft_params_vec & dparams, const std::vector<llama_tokens> * prefixes) {
+        calls.clear();
+        for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+            auto & dp = dparams[seq_id];
+            if (!dp.drafting) {
+                continue;
+            }
+            const llama_tokens & prefix = prefixes ? (*prefixes)[seq_id] : no_prefix;
+            auto & r = reqs[seq_id];
+
+            r.tokens.assign(dp.prompt->begin(), dp.prompt->end());
+            r.tokens.push_back(dp.id_last);
+            const size_t n_committed = r.tokens.size();
+            r.tokens.insert(r.tokens.end(), prefix.begin(), prefix.end());
+
+            const int32_t n_cap     = dp.n_max > 0 ? std::min(params.n_max, dp.n_max) : params.n_max;
+            const int32_t n_out_max = std::max(0, n_cap - (int32_t) prefix.size());
+            r.out.resize(n_out_max);
+
+            *dp.result = prefix;
+            if (n_out_max > 0) {
+                calls.push_back({ seq_id, dp.pos0, r.tokens.data(), r.tokens.size(), n_committed, r.out.data(), n_out_max, 0 });
+            }
+        }
+
+        if (calls.empty()) {
+            return;
+        }
+        api->draft(state, calls.data(), calls.size());
+
+        for (const auto & c : calls) {
+            auto & result = *dparams[c.seq_id].result;
+            const int32_t n_out = std::clamp(c.n_out, 0, c.n_out_max);
+            for (int32_t i = 0; i < n_out; ++i) {
+                if (c.out[i] < 0 || (n_vocab > 0 && c.out[i] >= n_vocab)) {
+                    break;
+                }
+                result.push_back(c.out[i]);
+            }
+        }
+    }
+
+    void draft(common_speculative_draft_params_vec & dparams) override {
+        draft_with(dparams, nullptr);
+    }
+
+    void accept(llama_seq_id seq_id, uint16_t n_accepted, bool is_other) override {
+        api->accept(state, seq_id, n_accepted, is_other ? 0 : 1);
+    }
+};

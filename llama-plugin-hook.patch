diff --git a/common/speculative-plugin.h b/common/speculative-plugin.h
new file mode 100644
index 0000000..5ff320e
--- /dev/null
+++ b/common/speculative-plugin.h
@@ -0,0 +1,93 @@
+#pragma once
+
+// C interface for a drafter loaded from a shared library: --spec-type plugin --spec-plugin FNAME
+//
+// The library exports one function, `llama_spec_plugin_get`, which returns a pointer to a static
+// `llama_spec_plugin` table. Token ids are llama_token values. A drafter only proposes tokens: the
+// target model verifies every draft, so a bad plugin can make decoding slower but not change the output.
+// The host calls a plugin from one thread at a time.
+//
+// A drafter that needs only the tokens implements init, free, begin, draft and accept. A drafter that
+// reads the target's results (e.g. an MTP head reading the target's hidden states through
+// llama_get_embeddings_nextn_ith(ctx_tgt, i)) also implements process, and get_state/set_state if it
+// keeps per-sequence state that must follow the server's context checkpoints. A plugin that runs its own
+// llama_context rolls it back itself: the host removes rejected draft tokens only from its own contexts.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LLAMA_SPEC_PLUGIN_API_VERSION 1
+#define LLAMA_SPEC_PLUGIN_ENTRY       "llama_spec_plugin_get"
+
+struct llama_spec_plugin_init_params {
+    uint32_t n_seq;      // sequences (server slots); seq_id is in [0, n_seq)
+    int32_t  n_max;      // longest draft the host takes, prefix tokens included (--spec-plugin-n-max)
+    int32_t  n_prefix;   // tokens the draft model drafts before the plugin (--spec-plugin-prefix)
+
+    int32_t  n_vocab;    // 0 when the host does not know the vocabulary
+    uint64_t vocab_hash; // FNV-1a 64 over the text of every token, each followed by a 0 byte; 0 when unknown
+
+    struct llama_context * ctx_tgt; // the target context, or NULL (e.g. in tests)
+
+    size_t               n_args; // --spec-plugin-args KEY=VALUE,...
+    const char * const * keys;
+    const char * const * values;
+};
+
+// a batch the target has just decoded; entry i is row i of the target's outputs
+struct llama_spec_plugin_batch {
+    int32_t         n_tokens;
+    const int32_t * tokens; // -1 for an entry given as an embedding (e.g. an image)
+    const int32_t * pos;    // first position of each entry
+    const int32_t * seq_id;
+    const int8_t  * output; // whether the batch asked for the entry's output
+};
+
+// one sequence to draft for
+struct llama_spec_plugin_draft {
+    int32_t         seq_id;
+    int32_t         pos;         // position of tokens[n_committed - 1] in the target context
+    const int32_t * tokens;      // [0, n_committed): the request so far, the last sampled token at the end
+    size_t          n_tokens;    // [n_committed, n_tokens): prefix tokens from the draft model, not verified yet
+    size_t          n_committed;
+    int32_t *       out;         // the plugin writes the tokens that follow tokens[n_tokens - 1] here
+    int32_t         n_out_max;
+    int32_t         n_out;       // set by the plugin; 0 means no draft
+};
+
+struct llama_spec_plugin {
+    int32_t api_version; // LLAMA_SPEC_PLUGIN_API_VERSION
+
+    // returns the plugin state, or NULL with a message in err
+    void * (*init)(const struct llama_spec_plugin_init_params * params, char * err, size_t err_size);
+
+    void (*free)(void * state);
+
+    // a new request starts in seq_id
+    void (*begin)(void * state, int32_t seq_id, const int32_t * prompt, size_t n_prompt);
+
+    // draft for every sequence in drafts at once, so a plugin that runs a model can batch them
+    void (*draft)(void * state, struct llama_spec_plugin_draft * drafts, size_t n_drafts);
+
+    // the target accepted n_accepted tokens of the last draft; is_own is 0 when another drafter made it
+    void (*accept)(void * state, int32_t seq_id, int32_t n_accepted, int32_t is_own);
+
+    // optional (may be NULL): called after every target decode, prompt chunks included, while the target's
+    // results for the batch can still be read; returns 0 on success
+    int32_t (*process)(void * state, const struct llama_spec_plugin_batch * batch);
+
+    // optional (may be NULL): per-sequence state saved with the server's context checkpoints. get_state
+    // returns the size and writes it to dst when it fits in size; set_state restores it
+    size_t (*get_state)(void * state, int32_t seq_id, uint8_t * dst, size_t size);
+    void   (*set_state)(void * state, int32_t seq_id, const uint8_t * src, size_t size);
+};
+
+typedef const struct llama_spec_plugin * (*llama_spec_plugin_get_fn)(void);
+
+#ifdef __cplusplus
+}
+#endif
